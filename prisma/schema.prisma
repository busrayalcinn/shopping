generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  role         String   @default("user")

  passwordHash String?
  googleId     String?  @unique
  image        String?

  createdAt    DateTime @default(now())

  passwordResets PasswordReset[]
  orders         Order[]
  returns        ReturnRequest[]
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sipariş durumları (src/lib/orderStatus.js ile aynı olmalı):
// pending    → ödeme bekleniyor (stok rezerve edildi)
// expired    → ödeme yapılmadı, rezerv bırakıldı
// paid       → ödendi, hazırlanmayı bekliyor
// preparing  → hazırlanıyor
// shipped    → kargoya verildi
// delivered  → teslim edildi (iade süresi buradan başlar)
// cancelled  → iptal edildi (stok geri döndü, para iade edildi)
model Order {
  id              Int       @id @default(autoincrement())
  userId          Int
  customerName    String
  address         String
  total           Int       // ödenen tutar (indirim düşülmüş)
  discountTotal   Int       @default(0) // kampanya indirimi, TL
  campaign        String?   // uygulanan kampanyanın kimliği
  status          String    @default("pending")
  stripeSessionId String?   @unique
  paymentIntentId String?
  refundedAmount  Int       @default(0) // TL, toplam iade edilen tutar
  stockReserved   Boolean   @default(false) // stok bu sipariş için düşüldü mü (çift iade/iadeyi önler)

  // Fatura bilgileri (sipariş anında alınır)
  billingType     String    @default("individual") // individual | corporate
  billingName     String?
  billingAddress  String?
  taxId           String?   // TCKN (bireysel, isteğe bağlı) veya VKN (kurumsal)
  taxOffice       String?

  // Kargo
  carrier         String?
  trackingNumber  String?

  cancelReason    String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  user    User            @relation(fields: [userId], references: [id])
  items   OrderItem[]
  events  OrderEvent[]
  returns ReturnRequest[]
  invoice Invoice?

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Int
  colorId   Int?   // eski siparişlerde boş olabilir
  colorName String? // sipariş anındaki renk adı (renk sonradan silinse de kalır)
  size      String
  qty       Int
  lineTotal Int    // bu satırda ödenen tutar (indirim düşülmüş)
  unitDiscount Int @default(0) // indirimli birim başına indirim, TL
  discountQty  Int @default(0) // satırdaki indirimli adet

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems ReturnItem[]
}

// Müşteriye gösterilen sipariş zaman çizelgesi
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  type      String
  message   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  category  String
  swatch    String
  textColor String
  imageUrl  String?
  active    Boolean  @default(true) // silmek yerine satıştan kaldırmak için
  createdAt DateTime @default(now())

  colors   ProductColor[]
  variants ProductVariant[]
}

// Ürünün renk seçenekleri. Her rengin kendi fotoğrafı olabilir.
model ProductColor {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  hex       String  // arayüzde gösterilen renk, örn. "#1c1917"
  imageUrl  String? // bu rengin fotoğrafı; yoksa düz renk gösterilir
  position  Int     @default(0)
  active    Boolean @default(true)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, name])
  @@index([productId])
}

// Renk + beden bazlı stok
model ProductVariant {
  id        Int    @id @default(autoincrement())
  productId Int
  colorId   Int
  size      String
  stock     Int    @default(0)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([colorId, size])
  @@index([productId])
}

// İade talebi: requested → approved → refunded   (veya rejected)
model ReturnRequest {
  id           Int       @id @default(autoincrement())
  orderId      Int
  userId       Int
  status       String    @default("requested")
  reason       String
  note         String?
  adminNote    String?
  refundAmount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refundedAt   DateTime?

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id])
  items ReturnItem[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id          Int @id @default(autoincrement())
  returnId    Int
  orderItemId Int
  qty         Int
  amount      Int @default(0) // bu kalem için iade edilecek tutar, TL

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
}

// Satış faturası. Sipariş ödendiğinde otomatik oluşturulur.
// `providerRef`: e-Arşiv entegratöründen (Paraşüt, Logo vb.) dönen belge kimliği.
model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  number      String?  @unique
  status      String   @default("draft") // draft | issued | failed | cancelled
  vatRate     Int      // yüzde, örn. 10
  subtotal    Int      // KDV hariç, kuruş
  vatAmount   Int      // kuruş
  total       Int      // KDV dahil, kuruş
  providerRef String?
  issuedAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
